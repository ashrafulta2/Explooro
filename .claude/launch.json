{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "explooro-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:server"],
      "port": 5000
    },
    {
      "name": "explooro-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:client"],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "explooro-client-live",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_API_MODE=live&& npm run dev:client"],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "explooro-client-mock",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_API_MODE=mock&& npm run dev --workspace client -- --port 3100"],
      "port": 3100,
      "url": "http://localhost:3100"
    },
    {
      "name": "explooro-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "port": 3001,
      "url": "http://localhost:3001"
    }
  ]
}
