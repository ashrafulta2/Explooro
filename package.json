{
  "name": "explooro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Explooro — social commerce and shop partner platform. Zero-bloat monorepo.",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names \"CLIENT,SERVER\" --prefix-colors \"cyan.bold,magenta.bold\" --kill-others-on-fail \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "node scripts/build-client.mjs && npm run prerender",
    "prerender": "node scripts/prerender.js",
    "preview": "npm run preview --workspace client",
    "test": "npm run test --workspace client && npm run test --workspace server"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
