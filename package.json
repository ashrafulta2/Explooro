{
  "name": "explooro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Explooro — social commerce and reseller partnership platform. Zero-bloat monorepo.",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names \"CLIENT,SERVER\" --prefix-colors \"cyan.bold,magenta.bold\" --kill-others-on-fail \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client && npm run prerender",
    "prerender": "node scripts/prerender.js",
    "preview": "npm run preview --workspace client",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
