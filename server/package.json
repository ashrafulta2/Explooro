{
  "name": "@explooro/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Explooro API — Fastify. Routes -> Controllers -> Services -> Repositories.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "node --test test/*.test.js",
    "migrate": "node src/db/migrate.ts up",
    "migrate:status": "node src/db/migrate.ts status",
    "check:sql": "node src/db/checkSql.ts",
    "typecheck": "tsc -p tsconfig.json",
    "seed": "node src/db/seed.ts",
    "covisit:rebuild": "node src/db/rebuildCovisits.ts",
    "reco:metrics": "node src/db/recoMetrics.ts"
  },
  "//dependencies": "Short, boring, audited list only. See the Dependency Policy in docs/prompt.md. Anything not already listed there needs a docs/dependency-ledger.md entry and isolation behind a single adapter file.",
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.0",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "jose": "6.2.10",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "sharp": "0.35.5"
  }
}
