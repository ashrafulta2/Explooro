#####################################################################
# Explooro — PRODUCTION environment checklist
#
# This is a CHECKLIST + template, not a file to copy blindly.
#   - Do NOT commit real values. Keep real secrets in the host's secret manager.
#   - Every value marked  [CHANGE]  must differ from development.
#   - Every value marked  [SECRET]  must be freshly generated for production.
#   - Variables are the same as .env.example; only the production values differ.
#
# Pre-launch checklist (tick each before going live):
#   [ ] NODE_ENV=production and PUBLIC_* URLs are HTTPS
#   [ ] JWT_SECRET / COOKIE_SECRET / PII_ENCRYPTION_KEY regenerated (NOT the dev or .env.example values)
#   [ ] PII_ENCRYPTION_KEY backed up somewhere safe — losing it makes encrypted NID/bank/KYC data unreadable
#   [ ] DATABASE_URL points at the production Postgres with sslmode=require; migrations + seed run
#   [ ] CACHE_DRIVER=redis with a real REDIS_URL (memory cache is single-node only)
#   [ ] Every *_DRIVER that should be real is switched off `mock`, and its credentials filled
#   [ ] Payment, courier and SMS tested in the provider's sandbox before live keys
#   [ ] STORAGE_DRIVER=r2 (local disk is lost on redeploy / not shared across nodes)
#   [ ] ADMIN_IP_ALLOWLIST set; REQUIRE_2FA_FOR_STAFF=true
#   [ ] Seeded dev accounts (+8801700000001..07) disabled or passwords changed
#   [ ] npm run build run AFTER setting VITE_* values (they are baked in at build time)
#   [ ] AI_MONTHLY_SPEND_CAP_USD set to an amount you are willing to lose
#####################################################################


#--------------------------------------------------------------------
# CORE
#--------------------------------------------------------------------
NODE_ENV=production                          # [CHANGE]
LOG_LEVEL=warn                               # [CHANGE] info is fine too
PORT=5000
HOST=0.0.0.0                                 # [CHANGE] bind for the reverse proxy / container
PUBLIC_WEB_URL=https://www.example.com       # [CHANGE] real HTTPS domain
PUBLIC_API_URL=https://api.example.com       # [CHANGE] real HTTPS domain


#--------------------------------------------------------------------
# CLIENT  (PUBLIC — baked into the bundle at build time; never a secret)
#--------------------------------------------------------------------
VITE_API_MODE=live                           # [CHANGE] mock would ship fake data
VITE_DEFAULT_LOCALE=en                       # fallback only; real default is /admin/platform/language


#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
DATABASE_URL=                                # [SECRET][CHANGE] production Postgres, ?sslmode=require
DATABASE_POOL_MAX=20                         # size to the DB plan's connection limit
DATABASE_STATEMENT_TIMEOUT_MS=10000


#--------------------------------------------------------------------
# CACHE / REDIS
#--------------------------------------------------------------------
CACHE_DRIVER=redis                           # [CHANGE] required once more than one node runs
REDIS_URL=                                   # [SECRET][CHANGE] rediss://...


#--------------------------------------------------------------------
# AUTH & SECURITY
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#--------------------------------------------------------------------
JWT_SECRET=                                  # [SECRET][CHANGE]
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=                               # [SECRET][CHANGE] different from JWT_SECRET

# base64 of exactly 32 bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this later orphans existing encrypted data — back it up.
PII_ENCRYPTION_KEY=                          # [SECRET][CHANGE]

ADMIN_IP_ALLOWLIST=                          # [CHANGE] comma-separated office/VPN IPs
REQUIRE_2FA_FOR_STAFF=true


#--------------------------------------------------------------------
# SMS GATEWAY  (greenweb / bulksmsbd / alphanet)
#--------------------------------------------------------------------
SMS_DRIVER=                                  # [CHANGE] not mock
SMS_API_KEY=                                 # [SECRET]
SMS_SENDER_ID=Explooro


#--------------------------------------------------------------------
# PAYMENTS  — test in sandbox first, then swap to live URLs/keys
#--------------------------------------------------------------------
PAYMENT_DRIVER=                              # [CHANGE] not mock

BKASH_BASE_URL=
BKASH_APP_KEY=                               # [SECRET]
BKASH_APP_SECRET=                            # [SECRET]
BKASH_USERNAME=                              # [SECRET]
BKASH_PASSWORD=                              # [SECRET]
BKASH_WEBHOOK_SECRET=                        # [SECRET]

NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=                           # [SECRET]
NAGAD_PUBLIC_KEY=

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=                   # [SECRET]


#--------------------------------------------------------------------
# COURIER / 3PL
#--------------------------------------------------------------------
COURIER_DRIVER=                              # [CHANGE] not mock

STEADFAST_API_KEY=                           # [SECRET]
STEADFAST_SECRET_KEY=                        # [SECRET]
STEADFAST_WEBHOOK_SECRET=                    # [SECRET]

PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=                        # [SECRET]
PATHAO_STORE_ID=

REDX_ACCESS_TOKEN=                           # [SECRET]


#--------------------------------------------------------------------
# MEDIA STORAGE
#--------------------------------------------------------------------
STORAGE_DRIVER=r2                            # [CHANGE]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=                            # [SECRET]
R2_SECRET_ACCESS_KEY=                        # [SECRET]
R2_BUCKET=
R2_PUBLIC_BASE_URL=

MAX_IMAGE_UPLOAD_MB=8
MAX_VIDEO_UPLOAD_MB=100


#--------------------------------------------------------------------
# SEARCH  (postgres is fine until the catalog is large)
#--------------------------------------------------------------------
SEARCH_DRIVER=postgres
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=                         # [SECRET]


#--------------------------------------------------------------------
# WHATSAPP / MESSENGER  — only if the feature is launched
#--------------------------------------------------------------------
WHATSAPP_DRIVER=mock
META_APP_SECRET=                             # [SECRET]
META_VERIFY_TOKEN=                           # [SECRET]
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=                       # [SECRET]


#--------------------------------------------------------------------
# PUSH & EMAIL
#--------------------------------------------------------------------
FCM_SERVER_KEY=                              # [SECRET]
EMAIL_DRIVER=                                # [CHANGE] not mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                               # [SECRET]
EMAIL_FROM=noreply@example.com               # [CHANGE] a verified sender on your domain


#--------------------------------------------------------------------
# LIVE STREAMING  — only if the feature is launched
#--------------------------------------------------------------------
STREAM_DRIVER=mock
STREAM_API_KEY=                              # [SECRET]
STREAM_API_SECRET=                           # [SECRET]
STREAM_HOST=


#--------------------------------------------------------------------
# AI
#--------------------------------------------------------------------
AI_DRIVER=mock                               # [CHANGE] to the real driver when launching AI features
ANTHROPIC_API_KEY=                           # [SECRET]
AI_MODEL=                                   # set a full model id before enabling AI
AI_MODEL_CONCIERGE=
AI_MODEL_SOURCING=
AI_MODEL_CREATIVE=
AI_MONTHLY_SPEND_CAP_USD=100                 # [CHANGE] hard ceiling on spend


#--------------------------------------------------------------------
# BUSINESS DEFAULTS — bootstrap only. After the first boot the database
# (platform_settings) is the source of truth; change them in the admin UI.
#--------------------------------------------------------------------
DEFAULT_SALER_SPLIT_PCT=40
DEFAULT_PLATFORM_SPLIT_PCT=60
DEFAULT_ESCROW_HOLD_DAYS=7
DEFAULT_MIN_PAYOUT_BDT=500
DEFAULT_CURRENCY=BDT
