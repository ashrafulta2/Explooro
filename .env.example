#####################################################################
# Explooro — environment template
#
# Copy to .env and fill in.  cp .env.example .env
#
# Rules:
#   - .env is git-ignored. NEVER commit real credentials.
#   - Every variable the project will ever need is listed here, even if the
#     phase that uses it has not been built yet. A variable that exists in code
#     but not in this file is a defect (enforced from Prompt 2.1 onward).
#   - Development needs almost nothing: the defaults below run the whole app
#     with no database, no Redis, no Docker and no paid accounts.
#####################################################################


#--------------------------------------------------------------------
# CORE  (Prompt 0.1 / 2.1)
#--------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# API server
PORT=5000
HOST=127.0.0.1

# Public base URLs. In development the Vite proxy makes /api same-origin,
# so these only matter for links generated server-side (emails, OG cards, QR).
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000


#--------------------------------------------------------------------
# CLIENT  (VITE_ prefix only — these are PUBLIC, visible in the browser bundle)
# Never put a secret behind VITE_.
#--------------------------------------------------------------------
# mock = UI runs on local fixtures, no backend needed  (Prompt 1.5)
# live = real API
VITE_API_MODE=mock
VITE_DEFAULT_LOCALE=bn


#--------------------------------------------------------------------
# DATABASE  (Prompt 2.1)  — NO DOCKER NEEDED
# Easiest path: create a free project at https://neon.tech and paste its
# connection string here. Alternative: install PostgreSQL 16 for Windows.
#--------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/explooro?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000


#--------------------------------------------------------------------
# CACHE / REDIS  (Prompt 2.1)  — OPTIONAL IN DEVELOPMENT
#   memory = in-process cache + pub/sub. Single node only. No install required.
#   redis  = real Redis. Free managed option: https://upstash.com
#--------------------------------------------------------------------
CACHE_DRIVER=memory
REDIS_URL=


#--------------------------------------------------------------------
# AUTH & SECURITY  (Prompt 2.3 / 12.2)
# Generate strong values:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#--------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=change_me_to_a_different_long_random_string

# Envelope encryption key for PII at rest (NID, bank accounts, KYC documents).
# Must be base64 for exactly 32 bytes (AES-256) — env.js refuses to boot otherwise.
# CHANGE THIS per environment: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=YgQ/rmA8zlQK/etr0TP1HoHvdyFKFA+Lqi+2Ih+j6Bk=

# Admin surface hardening
ADMIN_IP_ALLOWLIST=
REQUIRE_2FA_FOR_STAFF=true


#--------------------------------------------------------------------
# SMS GATEWAY  (Prompt 2.3)
#   mock    = OTP printed to the server console (development default)
#   greenweb / bulksmsbd / alphanet = real Bangladeshi gateways
#--------------------------------------------------------------------
SMS_DRIVER=mock
SMS_API_KEY=
SMS_SENDER_ID=Explooro


#--------------------------------------------------------------------
# PAYMENTS  (Prompt 5.3 / 6.3)
#   mock = simulates success, failure, timeout and delayed callbacks
#--------------------------------------------------------------------
PAYMENT_DRIVER=mock

# bKash — Tokenized Checkout + B2C disbursement
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_WEBHOOK_SECRET=

# Nagad — PGW
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=

# SSLCommerz — Rocket / card fallback
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=


#--------------------------------------------------------------------
# COURIER / 3PL  (Prompt 7.1)
#   mock = auto-advances a consignment through every delivery status
#--------------------------------------------------------------------
COURIER_DRIVER=mock

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_SECRET=

PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_STORE_ID=

REDX_ACCESS_TOKEN=


#--------------------------------------------------------------------
# MEDIA STORAGE  (Prompt 4.2)
#   local = writes to server/storage/ — development default, no cloud account
#   r2    = Cloudflare R2 (S3-compatible, zero egress fees)
#--------------------------------------------------------------------
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

MAX_IMAGE_UPLOAD_MB=8
MAX_VIDEO_UPLOAD_MB=100


#--------------------------------------------------------------------
# SEARCH  (Prompt 4.4)
#   postgres = tsvector + trigram, no extra infrastructure (default)
#   meilisearch = external index, for scale
#--------------------------------------------------------------------
SEARCH_DRIVER=postgres
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=


#--------------------------------------------------------------------
# WHATSAPP / MESSENGER  (Prompt 8.3)
#--------------------------------------------------------------------
WHATSAPP_DRIVER=mock
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=


#--------------------------------------------------------------------
# PUSH & EMAIL  (Prompt 8.2)
#--------------------------------------------------------------------
FCM_SERVER_KEY=
EMAIL_DRIVER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@explooro.com


#--------------------------------------------------------------------
# LIVE STREAMING  (Prompt 10.1 — provider chosen in that prompt)
#--------------------------------------------------------------------
STREAM_DRIVER=mock
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_HOST=


#--------------------------------------------------------------------
# AI  (Prompt 10.2)
#--------------------------------------------------------------------
AI_DRIVER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MONTHLY_SPEND_CAP_USD=100


#--------------------------------------------------------------------
# BUSINESS DEFAULTS
# These are BOOTSTRAP values only. Once Prompt 3.1 seeds platform_settings,
# the database is the source of truth and the Super Admin changes them in the
# UI with no redeploy. Never read these at runtime after Phase 3.
#--------------------------------------------------------------------
DEFAULT_SALER_SPLIT_PCT=40
DEFAULT_PLATFORM_SPLIT_PCT=60
DEFAULT_ESCROW_HOLD_DAYS=7
DEFAULT_MIN_PAYOUT_BDT=500
DEFAULT_CURRENCY=BDT
